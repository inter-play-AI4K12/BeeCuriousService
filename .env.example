BEECURIOUS_HOST=127.0.0.1
BEECURIOUS_PORT=8765
BEECURIOUS_AGENT_PROVIDER=mock
BEECURIOUS_MODEL=gpt-5.2
BEECURIOUS_DEFAULT_AGENT=bip
BEECURIOUS_DEFAULT_AGENT_VERSION=1.0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
LOKI_URL=https://loki-beetrap.interplaylab.io
LOKI_USER=beetrap
LOKI_PASSWORD=
# Optional custom CA bundle for institutional proxies or managed networks:
# SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem

# --- Bip behaviour toggles (see features.py) -------------------------------------------------
# All default ON; set any to "false" (case-insensitive) to disable. These shape Bip's dialogue
# and the activity choreography. The low-level rendering flags (idle wander, look-at-player,
# emotion particles, kick reaction) live separately on the mod side in BeetrapMC's run/.env.
# BIP_BREVITY=true              # keep replies to a single short line
# BIP_STAY_ON_TASK=true         # react only to the current moment; deflect off-topic chat
# BIP_LLM_IMPROV=true           # improvise narration/movement; off = fully scripted beats
# BIP_TIERED_HINTS=true         # escalate hints only while the player is stuck on a sub-task
# BIP_INTERACTIVE_QA=true       # ask "why did it die?", wait for an answer, judge it
# BIP_TIME_TRAVEL_HANDOVER=true # fly over and personally hand the player the clocks
# BIP_SCRIPTED_MEMORY=true      # feed scripted lines into the LLM so it remembers saying them
# NOTE: BIP_INTERACTIVE_QA and BIP_TIME_TRAVEL_HANDOVER are also read mod-side (run/.env);
# keep them in sync across both files.
